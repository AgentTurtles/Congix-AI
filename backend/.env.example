# COGNIX AI Backend Configuration

# Your Gemini API Key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=3000

# Allowed Origins (comma-separated for multiple origins)
# For local development: chrome-extension://your-extension-id
# For production: your-deployed-extension-id
ALLOWED_ORIGINS=*
